    "price = 29\n",
    "quantity = 8\n",
    "tax_rate = 55\n",
    "subtotal = price * quantity\n",
    "tax = subtotal * tax_rate\n",
    "total = subtotal + tax\n",
    "print(\"Subtotal:\", subtotal)\n",
    "print(\"Tax:\", tax)\n",
    "print(\"Total:\", total)"
